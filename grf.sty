%Comandos para listas:
\def\grf@runlist[]#1;#2[]#3{% Percorre a lista.
   \def\grf@test@runlist{#1}%
   \ifx\grf@test@runlist\grfendlist%
      \let\grf@next@runlist=\relax%
   \else%
      #3{#1}%
      \def\grf@next@runlist{\grf@runlist[]#2[]{#3}}%
   \fi%
   \grf@next@runlist%
}
\def\grf@listprepareA#1[]#2[]{%
   \def\grf@preparedlist{[]#2;#1;[]}%
}
\def\grf@listprepareB[]#1[]{%
   \expandafter\grf@listprepareA\grfendlist[]#1[]%
}
\newcommand{\grf@listprepare}[1]{%
   \expandafter\grf@listprepareB#1%
}
\newcommand{\grfrunlist}[2]{% Interface para \grf@runlist.
   \grf@listprepare{#1}%
   \expandafter\grf@runlist\grf@preparedlist{#2}%
}

\def\grf@listlast[]#1;#2;[]{%
   \def\grf@test@listlast{#2}%
   \ifx\grf@test@listlast\grfendlist%
      \def\grflast{#1}%
      \def\grf@next@listlast{\relax}%
   \else%
      \def\grf@next@listlast{\grf@listlast[]#2;[]}%
   \fi%
   \grf@next@listlast%
}
\newcommand{\grflistlast}[1]{%
   \grf@listprepare{#1}%
   \expandafter\grf@listlast\grf@preparedlist%
}

\newcommand{\settomaxwidth}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \def\grfloopcmd##1{%
         \settowidth{\grf@templengthA}{##1}%
         \ifdim\grf@templengthB<\grf@templengthA%
            \setlength{\grf@templengthB}{\grf@templengthA}%
         \fi%
      }%
      \setlength{\grf@templengthB}{0.0pt}%
      \grfrunlist{#2}{\grfloopcmd}%
      \global\edef\grf@tmp{\the\grf@templengthB}% Torna global a informação
   }%
   \setlength{#1}{\grf@tmp}% Atualiza a dimensão para o usuário.
}%

\newcommand{\settomaxdepth}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \def\grfloopcmd##1{%
         \settodepth{\grf@templengthA}{##1}%
         \ifdim\grf@templengthB<\grf@templengthA%
            \setlength{\grf@templengthB}{\grf@templengthA}%
         \fi%
      }%
      \setlength{\grf@templengthB}{0.0pt}%
      \grfrunlist{#2}{\grfloopcmd}%
      \global\edef\grf@tmp{\the\grf@templengthB}% Torna global a informação
   }%
   \setlength{#1}{\grf@tmp}% Atualiza a dimensão para o usuário.
}%

\newcommand{\settomaxheight}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \def\grfloopcmd##1{%
         \settoheight{\grf@templengthA}{##1}%
         \ifdim\grf@templengthB<\grf@templengthA%
            \setlength{\grf@templengthB}{\grf@templengthA}%
         \fi%
      }%
      \setlength{\grf@templengthB}{0.0pt}%
      \grfrunlist{#2}{\grfloopcmd}%
      \global\edef\grf@tmp{\the\grf@templengthB}% Torna global a informação
   }%
   \setlength{#1}{\grf@tmp}% Atualiza a dimensão para o usuário.
}%

\newcommand{\settomaxheightplusdepth}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \def\grfloopcmd##1{%
         \settoheight{\grf@templengthA}{##1}%
         \settodepth{\grf@templengthB}{##1}%
         \addtolength{\grf@templengthA}{\grf@templengthB}%
         \ifdim\grf@templengthC<\grf@templengthA%
            \setlength{\grf@templengthC}{\grf@templengthA}%
         \fi%
      }%
      \setlength{\grf@templengthC}{0.0pt}%
      \grfrunlist{#2}{\grfloopcmd}%
      \global\edef\grf@tmp{\the\grf@templengthC}% Torna global a informação
   }%
   \setlength{#1}{\grf@tmp}% Atualiza a dimensão para o usuário.
}%

