\def\grf@@add#1#2#3{%
   \ifx#3 %
      \global\grf@toks={#2#1}%
   \else%
      \global\grf@toks={#2#3{#1}}%
   \fi%
}
\def\grfadd#1#2#3{%
   \expandafter\grf@add\expandafter{#1}{#2}{#3}%
}
\newtoks{\grf@toks}
\newcommand{\grfmakeaxis}[5][ ]{%
   \FPupn{\x}{#2{} #5{} round}%
   \ifx#1 %
      \expandafter\grf@toks\expandafter=\expandafter{\expandafter[\expandafter]\x}%
   \else%
      \expandafter\grf@toks\expandafter=\expandafter{\expandafter[\expandafter]\expandafter#1\expandafter{\x}}%
   \fi%
   \foreach \i in {1,2,...,#4}%
   {%
      \FPupn{\x}{#4{} \i{} #4{} - #2{} * \i{} #3{} * + / #5{} round}%
      \grfadd{\the\grf@toks;}{\x}{#1}%
   }%
   \expandafter\grf@toks\expandafter=\expandafter{\the\grf@toks[]}%
   \expandafter\def\expandafter\grfaxis\expandafter{\the\grf@toks}%
}

