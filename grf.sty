%Eixos x:
\def\grf@xprepareparams[#1#2#3#4]{%
   \def\grf@paramA{b}%
   \def\grf@paramB{c}%
   \def\grf@paramC{c}%
   \grf@xaxistestparam{#1}%
   \grf@xaxistestparam{#2}%
   \grf@xaxistestparam{#3}%
}

\def\grf@xaxistestparam#1{%
   \ifx#1U%
      \def\grf@paramA{t}%
   \else%
   \ifx#1D%
      \def\grf@paramA{b}%
   \else%
   \ifx#1t%
      \def\grf@paramB{t}%
   \else%
   \ifx#1b%
      \def\grf@paramB{b}%
   \else%
   \ifx#1B%
      \def\grf@paramB{B}%
   \else%
   \ifx#1l%
      \def\grf@paramC{l}%
   \else%
   \ifx#1r%
      \def\grf@paramC{r}%
   \fi\fi\fi\fi\fi\fi\fi%
}

\newcommand{\grfsmashedxaxis}[3][c]{%
   \ifx#1l%
      \def\grf@lprorp{1.0}%
      \def\grf@rprorp{0.0}%
   \else%
      \ifx#1r%
         \def\grf@lprorp{0.0}%
         \def\grf@rprorp{1.0}%
      \else%
         \ifx#1c%
            \def\grf@lprorp{0.5}%
            \def\grf@rprorp{0.5}%
         \fi%
      \fi%
   \fi%
   \grfdbllistmin{#2}{#3}\grfdbllistmax{#2}{#3}%
   \ifx\grf@firstxaxis\grftrue%
      \let\grfxmin=\grfmin%
      \let\grfxmax=\grfmax%
      \let\grf@firstxaxis=\grffalse%
   \else%
      \FPmin{\grfxmin}{\grfxmin}{\grfmin}%
      \FPmax{\grfxmax}{\grfxmax}{\grfmax}%
   \fi%
   % Tamanhos laterais:
   %     Esquerda:
   \settowidth{\grf@templengthA}{\grfminlabel}%
   \setlength{\grf@templengthA}{\grf@rprorp\grf@templengthA}%
   \ifdim\grf@templengthA>\grfleftskip\setlength{\grfleftskip}{\grf@templengthA}\fi%
   %     Direita:
   \settowidth{\grf@templengthA}{\grfmaxlabel}%
   \setlength{\grf@templengthA}{\grf@lprorp\grf@templengthA}%
   \ifdim\grf@templengthA>\grfrightskip\setlength{\grfrightskip}{\grf@templengthA}\fi%
}

\newcommand{\grfxaxis}[3][]{%
   % Prepara argumentos de posicionamento.
   \grf@xprepareparams[#1{ }{ }{ }{ }]%
   \edef\grf@preparedargs{[\grf@paramA\grf@paramB\grf@paramC]}%
   % Define as macros adequadas para cada conjunto de parâmetros.
   \expandafter\grf@xaxisparseargs\grf@preparedargs%
   \ifx\grf@dosize\grftrue% Apenas quando calculando tamanhos.
      % Avalia ``salto'':
      \grf@evalaxisskip{#3}%
      \ifdim\grf@affecteddimen<\grf@templengthA\setlength{\grf@affecteddimen}{\grf@templengthA}\fi%
      % Máximo, mínimo e ``saltos'' laterais:
      \edef\grf@temp{[\grf@paramC]}%
      \expandafter\grfsmashedxaxis\grf@temp{#2}{#3}%
   \fi%
   \ifx\grf@doaxis\grftrue% Desenhando os eixos.
      \grf@evallabelspos{\grf@templengthA}{#3}%
      %Desenha efetivamente o eixo:
      \grflistmin{#2}\grflistmax{#2}%
      \draw[style=grfaxisstyle] (\grfmin,\grfxaxisypos) -- (\grfmax,\grfxaxisypos);
      \grfrundbllist{#2}{#3}{\grf@xaxislabelput}%
      \grfrundbllist{#2}{#3}{\grf@xaxistickput}%
   \fi%
}

\def\grf@xaxisparseargs[#1#2#3]{% Define as macros corretas para cada caso de posicionamento.
   \ifx#1t%
      \def\grf@affecteddimen{\grftopskip}%
      \ifx\grf@dopos\grftrue\def\grfxaxisypos{\grfymax}\fi%
      \ifx#2b%
         \def\grf@evalaxisskip##1{%
            \settomaxheightplusdepth{\grf@templengthA}{##1}%
            \ifdim\grf@templengthA>0.0pt%
               \addtolength{\grf@templengthA}{\grflabelsep}%
            \fi%
         }%
         \def\grf@evallabelspos##1##2{%
            \setlength{##1}{\grfxaxisypos\grfyunit}%
            \addtolength{##1}{\grflabelsep}%
         }%
         \def\grf@xaxisrefpoint{south}%
      \else%
         \ifx#2t%
            \def\grf@evalaxisskip##1{%
               \settomaxheightplusdepth{\grf@templengthA}{##1}%
               \ifdim\grf@templengthA>0.0pt%
                  \addtolength{\grf@templengthA}{\grflabelsep}%
               \fi%
            }%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfxaxisypos\grfyunit}%
               \settomaxheightplusdepth{\grf@templengthB}{##2}%
               \addtolength{##1}{\grf@templengthB}%
               \addtolength{##1}{\grflabelsep}%
            }%
            \def\grf@xaxisrefpoint{north}%
         \else%
            \ifx#2c%
               \def\grf@evalaxisskip##1{%
                  \settomaxheightplusdepth{\grf@templengthA}{##1}%
                  \ifdim\grf@templengthA>0.0pt%
                     \addtolength{\grf@templengthA}{\grflabelsep}%
                  \fi%
               }%
               \def\grf@evallabelspos##1##2{%
                  \settomaxheightplusdepth{\grf@templengthB}{##2}%
                  \setlength{##1}{\grfxaxisypos\grfyunit}%
                  \addtolength{##1}{0.5\grf@templengthB}%
                  \addtolength{##1}{\grflabelsep}%
               }%
               \def\grf@xaxisrefpoint{}%
            \else% Default = B!
               \def\grf@evalaxisskip##1{%
                  \settomaxheight{\grf@templengthA}{##1}%
                  \settomaxdepth{\grf@templengthB}{##1}%
                  \addtolength{\grf@templengthA}{\grf@templengthB}%
                  \ifdim\grf@templengthA>0.0pt%
                     \addtolength{\grf@templengthA}{\grflabelsep}%
                  \fi%
               }%
               \def\grf@evallabelspos##1##2{%
                  \settomaxdepth{##1}{##2}%
                  \addtolength{##1}{\grfxaxisypos\grfyunit}%
                  \addtolength{##1}{\grflabelsep}%
               }%
               \def\grf@xaxisrefpoint{base}%
            \fi%
         \fi%
      \fi%
   \fi%
   \ifx#1b%
      \def\grf@affecteddimen{\grfbottomskip}%
      \ifx\grf@dopos\grftrue\def\grfxaxisypos{\grfymin}\fi%
      \ifx#2t%
         \def\grf@evalaxisskip##1{%
            \settomaxheightplusdepth{\grf@templengthA}{##1}%
            \ifdim\grf@templengthA>0.0pt%
               \addtolength{\grf@templengthA}{\grflabelsep}%
            \fi%
         }%
         \def\grf@evallabelspos##1##2{%
            \setlength{##1}{\grfxaxisypos\grfyunit}%
            \addtolength{##1}{-\grflabelsep}%
         }%
         \def\grf@xaxisrefpoint{north}%
      \else%
         \ifx#2b%
            \def\grf@evalaxisskip##1{%
               \settomaxheightplusdepth{\grf@templengthA}{##1}%
               \ifdim\grf@templengthA>0.0pt%
                  \addtolength{\grf@templengthA}{\grflabelsep}%
               \fi%
            }%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfxaxisypos\grfyunit}%
               \settomaxheightplusdepth{\grf@templengthB}{##2}%
               \addtolength{##1}{-\grf@templengthB}%
               \addtolength{##1}{-\grflabelsep}%
            }%
            \def\grf@xaxisrefpoint{south}%
         \else%
            \ifx#2c%
               \def\grf@evalaxisskip##1{%
                  \settomaxheightplusdepth{\grf@templengthA}{##1}%
                  \ifdim\grf@templengthA>0.0pt%
                     \addtolength{\grf@templengthA}{\grflabelsep}%
                  \fi%
               }%
               \def\grf@evallabelspos##1##2{%
                  \settomaxheightplusdepth{\grf@templengthB}{##2}%
                  \setlength{##1}{\grfxaxisypos\grfyunit}%
                  \addtolength{##1}{-0.5\grf@templengthB}%
                  \addtolength{##1}{-\grflabelsep}%
               }%
               \def\grf@xaxisrefpoint{}%
            \else% Default = B!
               \def\grf@evalaxisskip##1{%
                  \settomaxheight{\grf@templengthA}{##1}%
                  \settomaxdepth{\grf@templengthB}{##1}%
                  \addtolength{\grf@templengthA}{\grf@templengthB}%
                  \ifdim\grf@templengthA>0.0pt%
                     \addtolength{\grf@templengthA}{\grflabelsep}%
                  \fi%
               }%
               \def\grf@evallabelspos##1##2{%
                  \settomaxheight{##1}{##2}%
                  \addtolength{##1}{-\grfxaxisypos\grfyunit}%
                  \addtolength{##1}{\grflabelsep}%
                  \setlength{##1}{-##1}%
               }%
               \def\grf@xaxisrefpoint{base}%
            \fi%
         \fi%
      \fi%
   \fi%
   \ifx#3l%
      \def\grf@xaxissecrefpoint{ west}%
   \else\ifx#3r%
         \def\grf@xaxissecrefpoint{ east}%
      \else%
         \def\grf@xaxissecrefpoint{}%
      \fi%
   \fi%
   \edef\grf@refpoints{[anchor=\grf@xaxisrefpoint\grf@xaxissecrefpoint]}%
   \def\grf@temp{[anchor=]}%
   \ifx\grf@refpoints\grf@temp\def\grf@refpoints{}\fi%
}

\newcommand{\grf@xaxistickput}[2]{%
   \ifx#2\grf@empty%
   \else%
      \draw[style=grftickstyle,xshift=#1\grfxunit,yshift=\grfxaxisypos\grfyunit] (0pt,-\grfticksize) -- (0pt,\grfticksize);
   \fi%
}

\newcommand{\grf@xaxislabelput}[2]{% Posiciona rótulos.
   \begin{scope}[inner sep=0pt,minimum size=0pt]
      \expandafter\node\grf@refpoints at (#1\grfxunit,\grf@templengthA) {\vphantom{#2}\smash{#2}};
   \end{scope}
}
