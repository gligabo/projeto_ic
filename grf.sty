\newcommand{\grflistmin}[1]{%
   {%Tudo local para não bagunçar o coreto.
      \grflistseparate{#1}%
      \def\grf@temp{\grffirst}%
      \def\grfloopcmd##1{%
         \FPmin{\grf@temp}{\grf@temp}{##1}%
      }%
     \grfrunlist{#1}{\grfloopcmd}%
     \global\edef\grfmin{\grf@temp}%
   }%
}
\newcommand{\grflistmax}[1]{%
   {%Tudo local para não bagunçar o coreto.
      \grflistseparate{#1}%
