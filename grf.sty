   \grf@yaxistestparam{#3}%
}

\def\grf@yaxistestparam#1{%
   \ifx#1L%
      \def\grf@paramA{L}%
   \else%
   \ifx#1R%
      \def\grf@paramA{R}%
   \else%
   \ifx#1t%
      \def\grf@paramC{t}%
   \else%
   \ifx#1b%
      \def\grf@paramC{b}%
   \else%
   \ifx#1B%
      \def\grf@paramC{B}%
   \else%
   \ifx#1l%
      \def\grf@paramB{l}%
   \else%
   \ifx#1r%
      \def\grf@paramB{r}%
   \fi\fi\fi\fi\fi\fi\fi%
}

\newcommand{\grfsmashedyaxis}[3][c]{%
   \ifx#1t%
      \def\grf@evaltopskip##1##2{%
         \setlength{##1}{0.0pt}%
      }%
      \def\grf@evalbottomskip##1##2{%
         \settoheight{##1}{##2}%
         \settodepth{\grf@templengthB}{##2}%
         \addtolength{##1}{\grf@templengthB}%
      }%
   \else%
      \ifx#1c%
         \def\grf@evaltopskip##1##2{%
            \settoheight{##1}{##2}%
            \settodepth{\grf@templengthB}{##2}%
            \addtolength{##1}{\grf@templengthB}%
            \setlength{##1}{0.5##1}%
         }%
         \def\grf@evalbottomskip##1##2{%
            \settoheight{##1}{##2}%
            \settodepth{\grf@templengthB}{##2}%
            \addtolength{##1}{\grf@templengthB}%
            \setlength{##1}{0.5##1}%
         }%
      \else%
         \ifx#1b%
            \def\grf@evaltopskip##1##2{%
               \settoheight{##1}{##2}%
               \settodepth{\grf@templengthB}{##2}%
               \addtolength{##1}{\grf@templengthB}%
            }%
            \def\grf@evalbottomskip##1##2{%
               \setlength{##1}{0.0pt}%
            }%
         \else%
            \ifx#1B%
               \def\grf@evaltopskip##1##2{%
                  \settoheight{##1}{##2}%
               }%
               \def\grf@evalbottomskip##1##2{%
                  \settodepth{##1}{##2}%
               }%
            \fi%
         \fi%
      \fi%
   \fi%
   % Máximos e mínimos:
   \grfdbllistmin{#2}{#3}\grfdbllistmax{#2}{#3}%
   \ifx\grf@firstyaxis\grftrue%
      \let\grfymin=\grfmin%
      \let\grfymax=\grfmax%
      \let\grf@firstyaxis=\grffalse%
   \else%
      \FPmin{\grfymin}{\grfymin}{\grfmin}%
      \FPmax{\grfymax}{\grfymax}{\grfmax}%
   \fi%
   \grfdbllistmax{#2}{#3}%
   \grfdbllistmin{#2}{#3}%
   \grf@evalbottomskip{\grf@templengthA}{\grfminlabel}%
   \ifdim\grf@templengthA>\grfbottomskip\setlength{\grfbottomskip}{\grf@templengthA}\fi%
   \grf@evaltopskip{\grf@templengthA}{\grfmaxlabel}%
   \ifdim\grf@templengthA>\grftopskip\setlength{\grftopskip}{\grf@templengthA}\fi%
}

\newcommand{\grfyaxis}[3][]{%
   % Prepara argumentos de posicionamento.
   \grf@yprepareparams[#1{ }{ }{ }{ }]%
   \edef\grf@preparedargs{[\grf@paramA\grf@paramB\grf@paramC]}%
   % Define as macros adequadas para cada conjunto de parâmetros.
   \expandafter\grf@yaxisparseargs\grf@preparedargs%
   % Apenas quando calculando tamanhos:
   \ifx\grf@dosize\grftrue%
      % Avalia ``salto'':
      \settomaxwidth{\grf@templengthC}{#3}%
      \ifdim\grf@templengthC>0.0pt%
         \addtolength{\grf@templengthC}{\grflabelsep}%
      \fi%
      \ifdim\grf@affecteddimen<\grf@templengthC\setlength{\grf@affecteddimen}{\grf@templengthC}\fi%
      % Máximo, mínimo  e saltos:
      \edef\grf@temp{[\grf@paramC]}%
      \expandafter\grfsmashedyaxis\grf@temp{#2}{#3}%
   \fi%
   \ifx\grf@doaxis\grftrue% Desenhando os eixos.
      \settomaxwidth{\grf@templengthC}{#3}%
      \grf@evallabelspos{\grf@templengthA}{\grf@templengthC}%
      %Desenha efetivamente o eixo:
      \grflistmin{#2}\grflistmax{#2}%
      \draw[style=grfaxisstyle] (\grfyaxisxpos,\grfmin) -- (\grfyaxisxpos,\grfmax);
      \grfrundbllist{#2}{#3}{\grf@yaxislabelput}%
      \grfrundbllist{#2}{#3}{\grf@yaxistickput}%
   \fi%
}

\def\grf@yaxisparseargs[#1#2#3]{%
   \ifx#1L%
      \def\grf@affecteddimen{\grfleftskip}%
      \ifx\grf@dopos\grftrue\def\grfyaxisxpos{\grfxmin}\fi%
      \ifx#2r%
         \def\grf@evallabelspos##1##2{%
            \setlength{##1}{\grfyaxisxpos\grfxunit}%
            \addtolength{##1}{-\grflabelsep}%
         }%
         \def\grf@refpoint{ east}%
      \else%
         \ifx#2l%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfyaxisxpos\grfxunit}%
               \addtolength{##1}{-\grflabelsep}%
               \addtolength{##1}{-##2}%
            }%
            \def\grf@refpoint{ west}%
         \else%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfyaxisxpos\grfxunit}%
               \addtolength{##1}{-\grflabelsep}%
               \addtolength{##1}{-0.5##2}%
            }%
            \def\grf@refpoint{}%
         \fi%
      \fi%
   \else
      \def\grf@affecteddimen{\grfrightskip}%
      \ifx\grf@dopos\grftrue\def\grfyaxisxpos{\grfxmax}\fi%
      \ifx#2r%
         \def\grf@evallabelspos##1##2{%
            \setlength{##1}{\grfyaxisxpos\grfxunit}%
            \addtolength{##1}{\grflabelsep}%
            \addtolength{##1}{##2}%
         }%
         \def\grf@refpoint{ east}%
      \else%
         \ifx#2l%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfyaxisxpos\grfxunit}%
               \addtolength{##1}{\grflabelsep}%
            }%
            \def\grf@refpoint{ west}%
         \else%
            \def\grf@evallabelspos##1##2{%
               \setlength{##1}{\grfyaxisxpos\grfxunit}%
               \addtolength{##1}{\grflabelsep}%

               \addtolength{##1}{0.5##2}%
            }%
            \def\grf@refpoint{}%
         \fi%
      \fi%
   \fi%
   \ifx#3t%
      \def\grf@secrefpoint{north}%
   \else%
      \ifx#3c%
         \def\grf@secrefpoint{}%
      \else%
         \ifx#3b%
            \def\grf@secrefpoint{south}%
         \else%
            \def\grf@secrefpoint{base}%
         \fi%
      \fi%
   \fi%
   \edef\grf@yaxisrefpoints{[anchor=\grf@secrefpoint\grf@refpoint]}%
   \def\grf@temp{[anchor=]}%
   \ifx\grf@yaxisrefpoints\grf@temp\def\grf@yaxisrefpoints{}\fi%
}

\newcommand{\grf@yaxistickput}[2]{%
   \ifx#2\grf@empty%
   \else%
      \draw[style=grftickstyle,yshift=#1\grfyunit,xshift=\grfyaxisxpos\grfxunit] (-\grfticksize,0pt) -- (\grfticksize,0pt);
   \fi%
}

\newcommand{\grf@yaxislabelput}[2]{% Posiciona rótulos.
   \begin{scope}[inner sep=0pt,minimum size=0pt]
      \expandafter\node\grf@yaxisrefpoints at (\grf@templengthA,#1\grfyunit) {#2};
   \end{scope}
}
