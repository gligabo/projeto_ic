\newcommand{\grflegend}[2][]{%
   \ifx\grf@doaxis\grftrue%
      \def\grf@paramA{r}%
      \def\grf@paramB{b}%
      \def\grf@temp{[#1{ }{ }{ }]}%
      \expandafter\grf@preparelegargs\grf@temp%
      \expandafter\ifx\grf@paramA r%
         \setlength{\grf@templengthA}{\grfxmax\grfxunit}%
         \def\grf@refpoint{ east}%
         \def\grf@signalA{-}%
      \else%
         \expandafter\ifx\grf@paramA l%
            \setlength{\grf@templengthA}{\grfxmin\grfxunit}%
            \def\grf@refpoint{ west}%
            \def\grf@signalA{+}%
         \fi%
      \fi%
      \expandafter\ifx\grf@paramB t%
         \setlength{\grf@templengthB}{\grfymax\grfyunit}%
         \def\grf@secrefpoint{north}%
         \def\grf@signalB{-}%
      \else%
         \expandafter\ifx\grf@paramB b%
            \setlength{\grf@templengthB}{\grfymin\grfyunit}%
            \def\grf@secrefpoint{south}%
            \def\grf@signalB{+}%
         \fi%
      \fi%
      \addtolength{\grf@templengthA}{\grf@signalA\grflegsep}%
      \addtolength{\grf@templengthB}{\grf@signalB\grflegsep}%
      \edef\grf@legrefpoints{[anchor=\grf@secrefpoint\grf@refpoint,}%
