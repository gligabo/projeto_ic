\newcommand{\grfdbllistmin}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \grflistseparate{#1}%
      \edef\grf@temp{\grffirst}%
      \def\grf@tempB{invalid number}%
      \def\grfloopcmd##1##2{%
         \FPmin{\grf@temp}{\grf@temp}{##1}%
         \ifx\grf@tempB\grf@temp%
         \else%
            \global\let\grfminlabel=##2%
            \let\grf@tempB=\grf@temp%
         \fi
      }%
     \grfrundbllist{#1}{#2}{\grfloopcmd}%
     \global\let\grfmin=\grf@temp%
   }%
}
\newcommand{\grfdbllistmax}[2]{%
   {%Tudo local para não bagunçar o coreto.
      \grflistseparate{#1}%
      \edef\grf@temp{\grffirst}%
      \def\grf@tempB{invalid number}%
      \def\grfloopcmd##1##2{%
         \FPmax{\grf@temp}{\grf@temp}{##1}%
         \ifx\grf@tempB\grf@temp%
         \else%
            \global\let\grfmaxlabel=##2%
            \let\grf@tempB=\grf@temp%
         \fi
      }%
     \grfrundbllist{#1}{#2}{\grfloopcmd}%
