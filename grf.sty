\newenvironment{grfgraphic}[2][1]{%
   % Dimensões default:
   \def\grfxmin{-1}\def\grfxmax{1}%
   \def\grfymin{-1}\def\grfymax{1}%
   \setlength{\grftopskip}{0.0pt}%
   \setlength{\grfbottomskip}{0.0pt}%
   \setlength{\grfleftskip}{0.0pt}%
   \setlength{\grfrightskip}{0.0pt}%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   % Calcula eixos:
   \def\grfaxisspecs{#2}%
   \let\grf@doaxis=\grffalse%
   \let\grf@dosize=\grftrue%
   \let\grf@firstxaxis=\grftrue%
   \let\grf@firstyaxis=\grftrue%
   \grfatopenspecs%
   \grfaxisspecs%
   \grfatclosespecs%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   % Cálculo da largura útil do gráfico:
   \setlength{\grf@templengthA}{\grftotalwidth}%
   \addtolength{\grf@templengthA}{-\grfleftskip}%
   \addtolength{\grf@templengthA}{-\grfrightskip}%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   %Cálculo dos fatores de escala:
   \FPupn{\grf@temp}{\grfxmin{} \grfxmax{} - 1 /}%
   \setlength{\grfxunit}{\grf@temp\grf@templengthA}%
   \setlength{\grfyunit}{#1\grfxunit}%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   % Extremos do quadro:
   \setlength{\grfleft}{\grfxmin\grfxunit}%
   \addtolength{\grfleft}{-\grfleftskip}%
   \setlength{\grfright}{\grfxmax\grfxunit}%
   \addtolength{\grfright}{\grfrightskip}%
   \setlength{\grfbottom}{\grfymin\grfyunit}%
   \addtolength{\grfbottom}{-\grfbottomskip}%
   \setlength{\grftop}{\grfymax\grfyunit}%
   \addtolength{\grftop}{\grftopskip}%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   % Centro:
   \FPupn{\grfxcenter}{2 \grfxmax{} \grfxmin{} + /}%
   \FPupn{\grfycenter}{2 \grfymax{} \grfymin{} + /}%
   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
   \begin{tikzpicture}[x=\grfxunit,y=\grfyunit]%
      \useasboundingbox (\grfleft,\grfbottom) rectangle (\grfright,\grftop);%
      \grfatopenframe%
}
{%
      \grfatcloseframe%
   \end{tikzpicture}%
}

\newenvironment{grfgraphic*}[2][1]{%
   \begin{grfgraphic}[#1]{#2}%
   \begin{scope}% Para não ``clipar'' os eixos.
      \clip (\grfxmin,\grfymin) rectangle (\grfxmax,\grfymax);%
}
{%
   \end{scope}%
   \end{grfgraphic}%
}


%Comandos para salvar/restaurar skips
\newcommand{\grfsaveskip}[1]{%
   \expandafter\edef\csname grf@rec#1skip\endcsname{\expandafter\the\csname grf#1skip\endcsname}%
}
\newcommand{\grfrestoreskip}[1]{%
   \expandafter\setlength\expandafter{\csname grf#1skip\endcsname}{\csname grf@rec#1skip\endcsname}%
   \expandafter\edef\csname grf@rec#1skip\endcsname{\expandafter\the\csname grf#1skip\endcsname}%
}
