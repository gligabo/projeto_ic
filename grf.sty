\def\grf@listcopy[]#1[]#2{%
   \def#2{[]#1[]}%
}
\newcommand{\grflistcopy}[2]{%
   \expandafter\grf@listcopy#2{#1}%
}

\def\grfrundbllist#1#2#3{%
   \grf@listprepare{#2}%
   \grflistcopy{\grf@currseclist@rundbllist}{\grf@preparedlist}%
   \def\grf@temp@rundbllist##1{%
      \grflistseparate{\grf@currseclist@rundbllist}%
      #3{##1}{\grffirst}%
      \grflistcopy{\grf@currseclist@rundbllist}{\grfrest}%
   }%
   \grfrunlist{#1}{\grf@temp@rundbllist}%
}
